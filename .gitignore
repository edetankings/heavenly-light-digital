
# ==========================================
# RPGM — Git Ignore
# ==========================================

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules/

# Build and framework output
dist/
build/
coverage/
dist-ssr/
.output/
.vinxi/
.tanstack/
.nitro/

# Environment variables
.env
.env.*
!.env.example
*.local

# Vercel local configuration
.vercel/

# Wrangler / Cloudflare
.wrangler/
.dev.vars
.dev.vars.*

# Editor files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Supabase local files
supabase/.temp/
supabase/.branches/
supabase/.env*
!supabase/.env.example

# Browser test reports
playwright-report/
test-results/

# Private credentials and backups
*.pem
*.key
*.p12
*.pfx
*.sql.bak